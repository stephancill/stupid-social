{
  "name": "stupid-social-android",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost",
    "android": "expo run:android --device",
    "check": "tsc --noEmit",
    "lint": "oxlint App.tsx ValidationApp.tsx app.config.ts index.ts src scripts tests --deny-warnings && cd .. && android-app/node_modules/.bin/oxlint scripts/*-web-client.ts --deny-warnings",
    "format": "oxfmt App.tsx ValidationApp.tsx app.config.ts index.ts src scripts tests && cd .. && android-app/node_modules/.bin/oxfmt scripts/*-web-client.ts",
    "fixture": "bun scripts/fixture-server.ts",
    "test": "bun test tests",
    "ios": "bash scripts/run-ios-simulator.sh"
  },
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "@expo/vector-icons": "^15.0.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@tanstack/react-query": "^5.103.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "expo": "~57.0.23",
    "expo-audio": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "htmlparser2": "^12.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "~19.2.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "~6.0.3"
  }
}
